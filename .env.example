# ========================================
# 🔑 ESSENTIAL SETTINGS FOR ANIMEI BOT
# ========================================

# Your Discord bot token (REQUIRED)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Path to your AnythingV5 model file (OPTIONAL - has default)
MODEL_PATH=C:\Stable Diffusion\stable-diffusion-webui\models\Stable-diffusion\anythingV5_fp16.safetensors

# Device to run AI model on (OPTIONAL - auto-detects GPU)
MODEL_DEVICE=cuda

# ========================================
# 📝 HOW TO USE:
# ========================================
# 1. Copy this file to .env
# 2. Replace 'your_discord_bot_token_here' with your actual bot token
# 3. Update MODEL_PATH if your model is in a different location
# 4. MODEL_DEVICE will auto-detect GPU, but you can force 'cpu' if needed
